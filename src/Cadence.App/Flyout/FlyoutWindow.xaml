<Window x:Class="Cadence.App.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cadence.App.Controls"
        xmlns:vm="clr-namespace:Cadence.App.ViewModels"
        xmlns:theme="clr-namespace:Cadence.App.Theme"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FlyoutViewModel}"
        Title="Cadence"
        Width="348" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource PageBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
      One provider. A 2px rule in the provider's own colour marks identity down the left edge,
      the way an entry card does on the source site; everything inside is the shared palette, so
      three provider brands never fight the navy.
    -->
    <DataTemplate x:Key="ProviderCardTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
      <!-- Each card carries its own trailing rule, so there is exactly one hairline between any
           two cards and one before the footer, with none left dangling at the top. -->
      <StackPanel>
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Column="0" Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                   Margin="0,12,0,12" />

        <StackPanel Grid.Column="1" Margin="12,12,14,14">

          <!-- Eyebrow: provider and plan on one tracked mono line, account beneath. -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock theme:Tracking.Text="{Binding Eyebrow}" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding Account}" Style="{StaticResource CaptionText}"
                         Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Grid.Column="1" theme:Tracking.Text="{Binding StatusText}" Style="{StaticResource LabelText}"
                       VerticalAlignment="Top" Margin="8,1,0,0" />
          </Grid>

          <!-- Error: one sentence, and the single action that fixes it. -->
          <Border Margin="0,0,0,12" Padding="11,9" CornerRadius="3"
                  Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ProseText}" />
              <TextBlock theme:Tracking.Text="{Binding ErrorAction}" Margin="0,6,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ErrorAction}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Quota windows -->
          <ItemsControl ItemsSource="{Binding Windows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:WindowRowViewModel}">
                <StackPanel Margin="0,0,0,15" ToolTip="{Binding Tooltip}">

                  <!-- Name and figure share a baseline; the figure is the largest thing here. -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BodyText}"
                               FontSize="{DynamicResource FontSm}" VerticalAlignment="Bottom"
                               Margin="0,0,8,1" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1" Text="{Binding UsedText}" MinWidth="40">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource BearBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <controls:UsageBar Height="6" Margin="0,0,0,7"
                                     Used="{Binding Used}"
                                     Forecast="{Binding ForecastValue}"
                                     ElapsedFraction="{Binding ElapsedFraction}"
                                     CornerRadius="2"
                                     TrackBrush="{DynamicResource TrackBrush}"
                                     FillBrush="{DynamicResource BarFillBrush}"
                                     AccentBrush="{DynamicResource AccentBrush}"
                                     PaceTickBrush="{DynamicResource PaceTickBrush}"
                                     OverrunBrush="{DynamicResource BearBrush}" />

                  <!-- Reset countdown left, prediction band right. Both mono, both tracked. -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" theme:Tracking.Text="{Binding ResetText}" Style="{StaticResource LabelText}" />

                    <!-- The band is the one place the dominant accent appears in text. -->
                    <TextBlock Grid.Column="1" Text="{Binding BandText}"
                               FontFamily="{DynamicResource NumericFont}"
                               FontSize="{DynamicResource FontMicro}"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Grid>

                  <TextBlock Text="{Binding Narrative}" Margin="0,6,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource ProseText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Narrative}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock theme:Tracking.Text="{Binding SpendText}" Style="{StaticResource LabelText}"
                     Visibility="{Binding HasSpend, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Hairline}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border BorderThickness="1" BorderBrush="{DynamicResource Hairline2Brush}" CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: brand mark, wordmark, refresh ============================================= -->
      <Grid Grid.Row="0" Margin="14,13,12,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The bordered-square mark from the source nav. -->
        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" Margin="0,0,9,0"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                VerticalAlignment="Center">
          <TextBlock Text="C" Foreground="{DynamicResource AccentBrush}"
                     FontFamily="{DynamicResource NumericFont}" FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Column="1" theme:Tracking.Text="CADENCE" Style="{StaticResource BrandText}"
                   VerticalAlignment="Center" />

        <Button Grid.Column="2" x:Name="RefreshButton" Style="{StaticResource IconButton}"
                Command="{Binding RefreshCommand}" ToolTip="Refresh now">
          <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                     RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <RotateTransform x:Name="RefreshRotation" Angle="0" />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Button>
      </Grid>

      <Border Grid.Row="0" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" />

      <!-- Provider cards, separated by hairlines rather than boxed ========================== -->
      <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}">
        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProviderCardTemplate}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Margin" Value="0" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </ScrollViewer>

      <!-- Footer: local cost, then actions ================================================== -->
      <StackPanel Grid.Row="2">
        <Grid Margin="14,11,14,9" Visibility="{Binding HasCost, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" theme:Tracking.Text="TODAY" Style="{StaticResource LabelText}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TodayText}"
                     Style="{StaticResource NumericText}" FontSize="{DynamicResource FontXs}"
                     Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Left"
                     TextAlignment="Left" />

          <TextBlock Grid.Row="1" Grid.Column="0" theme:Tracking.Text="30D" Style="{StaticResource LabelText}"
                     Margin="0,3,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MonthText}"
                     Style="{StaticResource NumericText}" FontSize="{DynamicResource FontXs}"
                     Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Left"
                     TextAlignment="Left" Margin="0,3,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding CostDisclaimer}" Style="{StaticResource CaptionText}"
                     FontSize="{DynamicResource FontMicro}" Opacity="0.8"
                     Margin="0,6,0,0" TextWrapping="Wrap" />
        </Grid>

        <Border Style="{StaticResource Hairline}"
                Visibility="{Binding HasCost, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6,8,7">
          <Button x:Name="HistoryButton" Content="HISTORY" Style="{StaticResource SubtleButton}" Click="OnHistoryClick" />
          <Button x:Name="SettingsButton" Content="SETTINGS" Style="{StaticResource SubtleButton}" Click="OnSettingsClick" />
          <Button x:Name="QuitButton" Content="QUIT" Style="{StaticResource SubtleButton}" Click="OnQuitClick" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
