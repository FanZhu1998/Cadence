<!--
  Dark palette, ported verbatim from fan-zhu.com.

  Every ink and accent value below was contrast-validated against its own surface at source; the
  ratios are kept in the comments so a future edit can be checked rather than guessed at. Alpha
  values are converted from rgba() to WPF's #AARRGGBB.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: deep navy, four steps -->
  <Color x:Key="PageColor">#080E18</Color>
  <Color x:Key="SurfaceColor">#0D1523</Color>
  <Color x:Key="Surface2Color">#121D2E</Color>
  <Color x:Key="Surface3Color">#1A273A</Color>

  <!-- Ink -->
  <Color x:Key="TextColor">#E8EEF7</Color>     <!-- 16.57:1 -->
  <Color x:Key="Text2Color">#A7B8CE</Color>    <!--  9.56:1 -->
  <Color x:Key="MutedColor">#7F92A9</Color>    <!--  6.06:1 -->

  <!-- Accent, two tones of one hue. AccentColor is the dominant, current term; Accent2Color the
       receded one. The forecast gets the dominant tone; structural labels get the receded. -->
  <Color x:Key="AccentColor">#7DABDD</Color>   <!--  8.05:1 -->
  <Color x:Key="AccentHiColor">#A7C8EE</Color> <!-- 11.17:1 -->
  <Color x:Key="Accent2Color">#628AB8</Color>  <!--  5.38:1 -->
  <Color x:Key="AccentDimColor">#247DABDD</Color>

  <!-- Semantic: headroom and overrun -->
  <Color x:Key="BullColor">#46BF94</Color>     <!--  8.41:1 -->
  <Color x:Key="BearColor">#E5776C</Color>     <!--  6.62:1 -->

  <!-- Sequential ramp, deep navy to luminous blue. Used by the history chart. -->
  <Color x:Key="Ramp1Color">#0F1E33</Color>
  <Color x:Key="Ramp2Color">#16304F</Color>
  <Color x:Key="Ramp3Color">#1C4470</Color>
  <Color x:Key="Ramp4Color">#235C92</Color>
  <Color x:Key="Ramp5Color">#4D8BC4</Color>
  <Color x:Key="Ramp6Color">#7FB0DD</Color>
  <Color x:Key="Ramp7Color">#B0D2F0</Color>

  <!-- Hairlines -->
  <Color x:Key="LineColor">#1AE8EEF7</Color>
  <Color x:Key="Line2Color">#29E8EEF7</Color>
  <Color x:Key="GlowColor">#1A7DABDD</Color>
  <Color x:Key="HoverColor">#14E8EEF7</Color>

  <!-- The bar's own track and fill. The fill is ink-toned rather than accent: the bar states a
       fact quietly, and the accent is reserved for the projection drawn beyond it. -->
  <Color x:Key="TrackColor">#1FE8EEF7</Color>
  <Color x:Key="BarFillColor">#A7B8CE</Color>
  <Color x:Key="PaceTickColor">#59E8EEF7</Color>

  <!-- HUD floats over arbitrary content, so it carries its own near-opaque surface -->
  <Color x:Key="HudBackgroundColor">#E60D1523</Color>
  <Color x:Key="HudBorderColor">#33A7B8CE</Color>
  <Color x:Key="HudTextColor">#E8EEF7</Color>
  <Color x:Key="HudMutedColor">#A7B8CE</Color>

  <!-- Brushes ================================================================================ -->

  <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource Surface2Color}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHiBrush" Color="{StaticResource AccentHiColor}" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />

  <SolidColorBrush x:Key="BullBrush" Color="{StaticResource BullColor}" />
  <SolidColorBrush x:Key="BearBrush" Color="{StaticResource BearColor}" />
  <SolidColorBrush x:Key="OverrunBrush" Color="{StaticResource BearColor}" />

  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="Hairline2Brush" Color="{StaticResource Line2Color}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}" />

  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
  <SolidColorBrush x:Key="BarFillBrush" Color="{StaticResource BarFillColor}" />
  <SolidColorBrush x:Key="PaceTickBrush" Color="{StaticResource PaceTickColor}" />

  <SolidColorBrush x:Key="HudBackgroundBrush" Color="{StaticResource HudBackgroundColor}" />
  <SolidColorBrush x:Key="HudBorderBrush" Color="{StaticResource HudBorderColor}" />
  <SolidColorBrush x:Key="HudTextBrush" Color="{StaticResource HudTextColor}" />
  <SolidColorBrush x:Key="HudMutedBrush" Color="{StaticResource HudMutedColor}" />

  <SolidColorBrush x:Key="Ramp1Brush" Color="{StaticResource Ramp1Color}" />
  <SolidColorBrush x:Key="Ramp4Brush" Color="{StaticResource Ramp4Color}" />
  <SolidColorBrush x:Key="Ramp6Brush" Color="{StaticResource Ramp6Color}" />
</ResourceDictionary>
