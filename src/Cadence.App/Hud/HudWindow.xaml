<Window x:Class="Cadence.App.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cadence.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HudViewModel}"
        Title="Cadence HUD"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <!-- Opacity lifts on hover so the strip stays out of the way while still being readable.
       The whole point is a readout you can ignore until you cannot.  -->
  <Border x:Name="Root" CornerRadius="7" Padding="9,6"
          Background="{DynamicResource HudBackgroundBrush}"
          BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Opacity" Value="0.82" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsHovered}" Value="True">
            <Setter Property="Opacity" Value="1.0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <StackPanel>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:HudRowViewModel}">
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Provider dot: the accent's only appearance here, as identity rather than status  -->
              <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Margin="0,0,7,0"
                      VerticalAlignment="Center"
                      Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />

              <TextBlock Grid.Column="1" Text="{Binding ShortName}"
                         FontFamily="{DynamicResource NumericFont}" FontSize="11"
                         Foreground="{DynamicResource HudMutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,7,0" />

              <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                         FontFamily="{DynamicResource NumericFont}" FontSize="12" FontWeight="SemiBold"
                         MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource HudTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsWarning}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCritical}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource OverrunBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PaceText}"
                           FontFamily="{DynamicResource NumericFont}" FontSize="11"
                           Foreground="{DynamicResource HudMutedBrush}"
                           MinWidth="26" Margin="0,0,8,0" />

                <TextBlock Text="{Binding OutlookText}"
                           FontFamily="{DynamicResource NumericFont}" FontSize="11"
                           Foreground="{DynamicResource HudMutedBrush}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Only appears on hover, so the strip stays clean but the drag affordance is discoverable  -->
      <!-- Width 0 with clipping disabled: the grip is a hover affordance and must never
           participate in measure, or the strip jumps sideways as the cursor arrives.  -->
      <Canvas Height="11" Margin="0,3,0,0">
        <TextBlock x:Name="Grip" Text="drag · click for details"
                   FontFamily="{DynamicResource UiFont}" FontSize="9"
                   Foreground="{DynamicResource HudMutedBrush}" Opacity="0.75"
                   Visibility="Collapsed" />
      </Canvas>
    </StackPanel>
  </Border>
</Window>
