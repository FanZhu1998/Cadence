# OS
Thumbs.db
desktop.ini
.DS_Store

# Credentials. Cadence reads other tools' sign-ins and must never carry one into this repository.
# tests/Cadence.Core.Tests/RepositoryHygieneTests.cs fails the build if one gets in anyway.
.env
.env.*
*.pem
*.pfx
*.p12
*.key
.credentials.json
auth.json
oauth_creds.json
.claude/settings.local.json
